# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fast_api_marketinsights
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database URL (can be constructed or set directly)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/fast_api_marketinsights

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# eNAM API Configuration
ENAM_API_URL=https://enam.gov.in/web/Ajax_ctrl/trade_data_list
ENAM_COOKIE=SERVERID=node1; ci_session=your_session_id_here

# Scheduler Configuration
SCHEDULER_HOUR=0
SCHEDULER_MINUTE=45

# Application Paths
PYTHONPATH=/app/market-insight
WORK_DIR=/opt/enaam_data_collection
